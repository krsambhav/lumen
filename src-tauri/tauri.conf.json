{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.2.11",
  "identifier": "app.lumen.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "category": "Video",
    "copyright": "",
    "shortDescription": "A video player for macOS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": [
        "../vendor/lib/libmpv.2.dylib",
        "../vendor/lib/libavcodec.63.dylib",
        "../vendor/lib/libavfilter.12.dylib",
        "../vendor/lib/libavformat.63.dylib",
        "../vendor/lib/libavutil.61.dylib",
        "../vendor/lib/libswresample.7.dylib",
        "../vendor/lib/libswscale.10.dylib"
      ],
      "files": {
        "MacOS/ffmpeg": "../vendor/bin/ffmpeg",
        "MacOS/ffprobe": "../vendor/bin/ffprobe"
      },
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MTFBQUVBQTc4NUE4REIKUldUYnFJV242cW9SV0xFRzB2U3J2Q0t2S25JMFNMNHNDVEMybWVkM0NIODVLQW1pQTY2b1VnNzgK",
      "endpoints": [
        "https://github.com/krsambhav/lumen/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
