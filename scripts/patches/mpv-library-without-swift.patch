diff --git a/meson.build b/meson.build
index b15f310..7a13f3f 100644
--- a/meson.build
+++ b/meson.build
@@ -437,8 +437,7 @@ if features['cocoa']
     path_source += files('osdep/path-mac.m')
     sources += files('osdep/language-mac.c',
                      'osdep/utils-mac.c',
-                     'osdep/mac/app_bridge.m',
-                     'player/clipboard/clipboard-mac.m')
+                     'osdep/mac/app_bridge.m')
     main_fn_source = files('osdep/main-fn-mac.c')
 endif
 
@@ -1628,6 +1627,10 @@ swift = get_option('swift-build').require(
 )
 features += {'swift': swift.allowed()}
 
+if features['cocoa'] and features['swift']
+    sources += files('player/clipboard/clipboard-mac.m')
+endif
+
 if features['cocoa'] and not features['swift'] and get_option('cplayer')
     error('cplayer enabled but no suitable swift version could be found or was disabled!')
 endif
diff --git a/osdep/mac/app_bridge.m b/osdep/mac/app_bridge.m
index 58e10cb..14e0f00 100644
--- a/osdep/mac/app_bridge.m
+++ b/osdep/mac/app_bridge.m
@@ -165,4 +165,33 @@ int cocoa_main(int argc, char *argv[])
 {
     return [(Application *)[Application sharedApplication] main:argc :argv];
 }
+#else
+#include "mpv/client.h"
+
+// Without the Swift application code there is no AppHub to forward to. These
+// are still called by the core (mp_create, the input and client code), so
+// they must exist; an embedding host handles media keys and input itself.
+void cocoa_init_media_keys(void)
+{
+}
+
+void cocoa_uninit_media_keys(void)
+{
+}
+
+void cocoa_set_input_context(struct input_ctx *input_context)
+{
+}
+
+void cocoa_set_mpv_handle(struct mpv_handle *ctx)
+{
+    // The core creates this client for the application hub. Without the hub
+    // nothing would ever read its events, and the core waits for every client
+    // to start reading before it plays anything, so release it here.
+    mpv_destroy(ctx);
+}
+
+void cocoa_init_cocoa_cb(void)
+{
+}
 #endif
