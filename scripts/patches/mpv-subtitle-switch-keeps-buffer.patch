diff --git a/demux/demux.c b/demux/demux.c
index 296993b..ef38782 100644
--- a/demux/demux.c
+++ b/demux/demux.c
@@ -4212,9 +4212,25 @@ static void initiate_refresh_seek(struct demux_internal *in,
             return;
         }
 
+        // Lumen: a subtitle track that is switched on needs only its own
+        // packets from a little before the current position. Everything
+        // else keeps what it has buffered and plays on from it while the
+        // file is read again, and the packets read twice are dropped once
+        // they reach the last one already queued. Without this, switching
+        // subtitles stalls the picture for as long as it takes to read the
+        // file again, which over a network can be seconds.
+        bool keep_buffered = stream->type == STREAM_SUB;
+
         for (int n = 0; n < in->num_streams; n++) {
             struct demux_stream *ds = in->streams[n]->ds;
 
+            if (keep_buffered && ds != stream) {
+                if (ds->selected && (ds->queue->last_pos != -1 ||
+                                     ds->queue->last_dts != MP_NOPTS_VALUE))
+                    ds->refreshing = true;
+                continue;
+            }
+
             bool correct_pos = ds->queue->correct_pos;
             bool correct_dts = ds->queue->correct_dts;
 
