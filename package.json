    "test:watch": "vitest",
    "tauri": "tauri",
    "icon": "node scripts/render-icon.mjs && tauri icon src-tauri/icons/source.png",
    "deps:native": "scripts/build-deps.sh",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
